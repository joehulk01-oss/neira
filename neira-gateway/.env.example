# Neira Gateway — salin ke .env lalu isi, JANGAN commit .env ke git.

# Rahasia admin + kredensial PC (Neira.exe). Buat sendiri, mis:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
GATEWAY_TOKEN=

# Domain VPS (dipakai Caddy untuk HTTPS otomatis)
DOMAIN=neira.example.com

# Port internal gateway (di dalam Docker; publik lewat Caddy :443)
GATEWAY_PORT=8765

# Masa berlaku token pairing (detik)
PAIRING_TTL=300

# Nama gateway (tampil di /gateway/info)
GATEWAY_NAME=Neira Gateway
